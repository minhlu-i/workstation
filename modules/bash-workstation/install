#!/usr/bin/env bash
set -euo pipefail
module=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
mode=${1-}
case $mode in
    ''|--configure-only) (( $# <= 1 )) || exit 2 ;;
    --help) printf 'Usage: setup-bash-workstation [--configure-only|--verify|--help]\n'; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$mode" >&2; exit 2 ;;
esac
fail() { printf 'setup-bash-workstation: %s\n' "$*" >&2; exit 1; }
# Fixed destinations are part of this module's contract. Avoid a split configuration.
[[ ${XDG_CONFIG_HOME:-$HOME/.config} == "$HOME/.config" ]] || fail 'XDG_CONFIG_HOME must be ~/.config for this module.'
[[ ${MISE_CONFIG_DIR:-$HOME/.config/mise} == "$HOME/.config/mise" ]] || fail 'MISE_CONFIG_DIR must be ~/.config/mise.'
[[ -z ${MISE_GLOBAL_CONFIG_FILE-} ]] || fail 'Unset MISE_GLOBAL_CONFIG_FILE before setup.'
export PATH="$HOME/.local/bin:$PATH"
if [[ $mode != --configure-only ]]; then
    [[ $(uname -s) == Linux ]] || fail 'Installer supports Ubuntu/WSL2 only; macOS installation is not yet implemented.'
    source /etc/os-release
    [[ $ID == ubuntu ]] || fail 'Installer supports Ubuntu/WSL2 only.'
    packages=()
    for package in bash bash-completion ca-certificates curl git less xz-utils; do
        [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || :) == 'install ok installed' ]] || packages+=("$package")
    done
    if (( BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 3) )); then
        packages+=(bash)
    fi
    if (( ${#packages[@]} )); then
        elevate=()
        (( EUID == 0 )) || elevate=(sudo)
        "${elevate[@]}" apt-get update
        "${elevate[@]}" apt-get install -y "${packages[@]}"
    fi
    # A package upgrade does not change the interpreter already running this script.
    if [[ ${WORKSTATION_BASH_REEXEC-} != 1 ]]; then
        export WORKSTATION_BASH_REEXEC=1
        exec /bin/bash "$module/install" "$@"
    fi
fi
(( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 3) )) ||
    fail 'Bash 5.3+ is required. Upgrade to an Ubuntu release supplying Bash 5.3+ through apt, then rerun. No shell files were changed.'
if [[ $mode != --configure-only ]] && ! command -v mise >/dev/null 2>&1; then
    installer=$(mktemp)
    trap 'rm -f -- "$installer"' EXIT
    curl --proto '=https' --tlsv1.2 -fsSL https://mise.run -o "$installer"
    MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh "$installer"
    rm -f -- "$installer"
    trap - EXIT
fi
for file in "$module/files/bashrc" "$module/files/"*.bash "$module/files/rc.d/"*.bash; do
    bash -n "$file"
done
for file in "$HOME/.config/bash/local.bash" "$HOME/.config/bash/rc.d/"*.bash; do
    [[ ! -e $file ]] || bash -n "$file"
done
backup=''
write_owned() {
    local source=$1 destination=$2 relative=$3 temporary
    [[ ! -d $destination ]] || fail "Expected a file, found directory: $destination"
    if [[ -f $destination && ! -L $destination ]] && cmp -s "$source" "$destination"; then return; fi
    if [[ -e $destination || -L $destination ]]; then
        if [[ -z $backup ]]; then
            mkdir -p "$HOME/.local/state/workstation/bash-workstation/backups"
            backup=$(mktemp -d "$HOME/.local/state/workstation/bash-workstation/backups/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
            printf 'Backup: %s\n' "$backup"
        fi
        mkdir -p "$(dirname -- "$backup/$relative")"
        cp -a -- "$destination" "$backup/$relative"
    fi
    mkdir -p "$(dirname -- "$destination")"
    temporary=$(mktemp "${destination}.XXXXXX")
    cp -- "$source" "$temporary"
    chmod 644 "$temporary"
    mv -f -- "$temporary" "$destination"
}
write_user() {
    local source=$1 destination=$2
    if [[ ! -e $destination && ! -L $destination ]]; then
        mkdir -p "$(dirname -- "$destination")"
        # Noclobber also protects against another setup process creating this file.
        (set -o noclobber; cat "$source" > "$destination")
    fi
}
write_owned "$module/files/mise.toml" "$HOME/.config/mise/conf.d/bash-workstation.toml" .config/mise/conf.d/bash-workstation.toml
if [[ $mode != --configure-only ]]; then
    # Operate outside a caller's project so its mise configuration cannot govern setup.
    cd "$HOME"
    missing_tools=()
    for tool in bat delta eza fd jq ripgrep starship tealdeer yq zoxide github:HalFrgrd/flyline; do
        mise where "$tool" >/dev/null 2>&1 || missing_tools+=("$tool")
    done
    if (( ${#missing_tools[@]} )); then
        mise install "${missing_tools[@]}"
    fi
fi
write_owned "$module/files/bashrc" "$HOME/.config/bash/bashrc" .config/bash/bashrc
for file in "$module/files/rc.d/"*.bash; do
    name=${file##*/}
    if [[ $name == 45-user-aliases.bash ]]; then
        write_user "$file" "$HOME/.config/bash/rc.d/$name"
    else
        write_owned "$file" "$HOME/.config/bash/rc.d/$name" ".config/bash/rc.d/$name"
    fi
done
write_user "$module/files/local.bash" "$HOME/.config/bash/local.bash"
write_owned "$module/files/starship.toml" "$HOME/.config/starship.toml" .config/starship.toml
# Switch the entrypoint last, after all its dependencies have been written.
write_owned "$module/files/bootstrap.bash" "$HOME/.bashrc" .bashrc
for file in "$HOME/.bashrc" "$HOME/.config/bash/bashrc" "$HOME/.config/bash/local.bash" "$HOME/.config/bash/rc.d/"*.bash; do
    bash -n "$file"
done
if [[ $mode == --configure-only ]]; then
    printf 'Configuration generated; run setup-bash-workstation --verify to check installed tools.\n'
else
    bash "$module/verify"
    printf 'Bash workstation ready. Open a new Bash terminal.\n'
fi
