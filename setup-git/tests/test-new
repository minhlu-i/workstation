#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
export HOME="$work/home with spaces" XDG_CONFIG_HOME="$work/home with spaces/.config" GIT_CONFIG_NOSYSTEM=1
unset GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_DIR GIT_WORK_TREE
mkdir -p "$HOME" "$work/bin"
export VAULT_CALLS="$work/vault-calls"
cat > "$work/bin/bw" <<'DOUBLE'
#!/bin/sh
printf '%s\n' "$*" >> "$VAULT_CALLS"
exit 99
DOUBLE
chmod +x "$work/bin/bw"
export PATH="$work/bin:$PATH"
install() { bash "$root/setup-git/install-personal.sh" "$@"; }
expect_failure() { if "$@" > "$work/error" 2>&1; then exit 1; fi; }
# Interactive username/email entry requires no profile file or CLI identity flags.
printf 'example-user\nuser@example.invalid\n' | WORKSTATION_GIT_PROFILE_ITEM=unused-note install new > "$work/output"
bash "$root/setup-git/verify-personal.sh" >/dev/null
[[ ! -s $VAULT_CALLS ]]
[[ $(jq -r .accounts.personal.name "$HOME/.config/git/workstation-profile.json") == example-user ]]
[[ $(jq -r .accounts.personal.githubOwner "$HOME/.config/git/workstation-profile.json") == example-user ]]
grep -q 'user@example.invalid' "$HOME/.ssh/workstation/personal.pub"
ssh-keygen -y -P '' -f "$HOME/.ssh/workstation/personal" > "$work/derived.pub"
[[ $(ssh-keygen -lf "$work/derived.pub" | awk '{print $2}') == $(ssh-keygen -lf "$HOME/.ssh/workstation/personal.pub" | awk '{print $2}') ]]
git init -q "$HOME/Workspace/personal/repo"
[[ $(git -C "$HOME/Workspace/personal/repo" config user.email) == user@example.invalid ]]
[[ $(git -C "$HOME/Workspace/personal/repo" ls-remote --get-url git@github.com:example-user/repo) == git@gh-personal:example-user/repo ]]
cp "$HOME/.ssh/workstation/personal" "$work/key-before"
install new --username example-user --email user@example.invalid --no-input >/dev/null
cmp "$work/key-before" "$HOME/.ssh/workstation/personal"
# Add another account without replacing the existing profile/key.
install new --account work --username example-work --email work@example.invalid --workspace Projects/Work --no-input >/dev/null
[[ $(jq '.accounts | length' "$HOME/.config/git/workstation-profile.json") == 2 ]]
cmp "$work/key-before" "$HOME/.ssh/workstation/personal"
[[ -f $HOME/.ssh/workstation/work && ! -s $VAULT_CALLS ]]
install >/dev/null
bash "$root/setup-git/verify-personal.sh" >/dev/null
# Missing input and invalid IDs must not generate/deploy anything.
export HOME="$work/invalid" XDG_CONFIG_HOME="$work/invalid/.config"
mkdir "$HOME"
expect_failure install new --no-input
grep -q 'requires --username and --email' "$work/error"
expect_failure install new --username invalid-user --email x@example.invalid --account config --no-input
expect_failure install new --username invalid-user --email x@example.invalid --account ../escape --no-input
expect_failure install new --username invalid-user --email x@example.invalid --workspace ../escape --no-input
expect_failure install new bitwarden
expect_failure install bitwarden --username wrong
[[ ! -e $HOME/.ssh && ! -e $HOME/.config && ! -s $VAULT_CALLS ]]
# Partial existing pairs are never overwritten by new.
mkdir -p "$HOME/.ssh/workstation"
cp "$work/key-before" "$HOME/.ssh/workstation/personal"
expect_failure install new --username invalid-user --email x@example.invalid --no-input
cmp "$work/key-before" "$HOME/.ssh/workstation/personal"
[[ ! -e $HOME/.ssh/workstation/personal.pub && ! -e $HOME/.config ]]
# First-run mode selection is exercised with a real pseudo-terminal.
export MENU_HOME="$work/menu-home" MODULE_INSTALL="$root/setup-git/install-personal.sh"
mkdir "$MENU_HOME"
python3 - <<'PY'
import os, pty, subprocess
master, slave = pty.openpty()
env = dict(os.environ, HOME=os.environ['MENU_HOME'], XDG_CONFIG_HOME=os.environ['MENU_HOME']+'/.config')
child = subprocess.Popen(['bash', os.environ['MODULE_INSTALL']], stdin=slave,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
os.close(slave)
try:
    os.write(master, b'new\nmenu-user\nmenu@example.invalid\n')
    out, err = child.communicate(timeout=20)
    assert child.returncode == 0, (out.decode(), err.decode())
    assert b'Choose new or bitwarden:' in err
finally:
    if child.poll() is None:
        child.kill()
        child.wait()
    os.close(master)
PY
[[ -f $MENU_HOME/.ssh/workstation/personal && ! -s $VAULT_CALLS ]]
printf 'PASS new prompts, Ed25519 creation, identities/URL routing, key reuse, account addition and failure boundaries\n'
