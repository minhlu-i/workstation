#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
export HOME="$work/home with spaces" XDG_CONFIG_HOME="$work/home with spaces/.config" GIT_CONFIG_NOSYSTEM=1
unset GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_DIR GIT_WORK_TREE GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL EMAIL WORKSTATION_SSH_AGENT_SOCKET
source "$root/setup-git/tests/fixtures.bash"
prepare_vault_fixture
mkdir -p "$HOME/.ssh"
printf '[alias]\n    custom = status -sb\n[core]\n    excludesFile = %s/.gitignore_global\n' "$HOME" > "$HOME/.gitconfig"
printf 'experimental\n' > "$HOME/.gitignore_global"
cat > "$HOME/.ssh/config" <<'CONFIG'
Host gh-p
    HostName github.com
    IdentityFile ~/.ssh/personal
Host gh-s5
    HostName github.com
    IdentityFile ~/.ssh/s5tech
Host unrelated
    HostName example.com
    User preserved
CONFIG
cp "$HOME/.gitconfig" "$work/original-git"
cp "$HOME/.ssh/config" "$work/original-ssh"
bash "$root/setup-git/install-personal.sh"
[[ $(git config --global alias.custom) == 'status -sb' ]]
! git config --global --get core.excludesfile
[[ -f $HOME/.gitignore_global ]]
ssh -G -F "$HOME/.ssh/config" unrelated 2>/dev/null | grep -q '^user preserved$'
backups="$HOME/.local/state/workstation/bash-workstation/backups"
first=$(find "$backups" -mindepth 1 -maxdepth 1 -type d)
cmp "$work/original-git" "$first/.gitconfig"
cmp "$work/original-ssh" "$first/.ssh/config"
bash "$root/setup-git/install-personal.sh" --configure-only >/dev/null
[[ $(find "$backups" -mindepth 1 -maxdepth 1 -type d | wc -l) == 1 ]]
for account in personal s5tech; do
    dir="$HOME/Workspace/$account/test"
    git init -q "$dir"
    name=fixture-personal; org=fixture-personal; alias=gh-p
    if [[ $account == s5tech ]]; then name=fixture-work; org=fixture-work; alias=gh-s5; fi
    [[ $(git -C "$dir" config user.name) == "$name" ]]
    [[ $(git -C "$dir" symbolic-ref --short HEAD) == main ]]
    for url in "git@github.com:$org/example" "ssh://git@github.com/$org/example"; do
        [[ $(git -C "$dir" ls-remote --get-url "$url") == "git@$alias:$org/example" ]]
    done
    [[ $(git -C "$dir" ls-remote --get-url "https://github.com/$org/example") == "https://github.com/$org/example" ]]
done
git init -q "$HOME/outside"
if git -C "$HOME/outside" var GIT_AUTHOR_IDENT >/dev/null 2>&1; then exit 1; fi
bash "$root/setup-git/verify-personal.sh"
ssh -G -F "$HOME/.ssh/config" gh-p 2>/dev/null | grep -Fxq 'identityagent none'
# Offline reruns never contact the vault, even when no CLI session is available.
cp "$VAULT_CALLS" "$work/calls-before"
unset BW_SESSION
bash "$root/setup-git/install-personal.sh" --configure-only >/dev/null
bash "$root/setup-git/install-personal.sh" >/dev/null
cmp "$VAULT_CALLS" "$work/calls-before"
# Additional identities from a wildcard must not silently bypass the selected key.
printf '\nHost *\n    IdentityFile ~/.ssh/unexpected\n' >> "$HOME/.ssh/config"
if bash "$root/setup-git/verify-personal.sh" --config-only > "$work/failure" 2>&1; then exit 1; fi
grep -q 'Unexpected additional/replaced IdentityFile' "$work/failure"
# A malformed Git root must fail before deploying any new managed config.
export HOME="$work/broken" XDG_CONFIG_HOME="$work/broken/.config"
mkdir -p "$HOME"
printf '[broken\n' > "$HOME/.gitconfig"
if bash "$root/setup-git/install-personal.sh" --configure-only >/dev/null 2>&1; then exit 1; fi
[[ ! -e $HOME/.ssh && ! -e $HOME/.config/git ]]
printf 'PASS Git config, identities, rewrites, SSH selection, preservation, backups and failure diagnostics\n'
