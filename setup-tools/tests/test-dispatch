#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
workspace_test_dir=$(mktemp -d)
trap 'rm -rf -- "$workspace_test_dir"' EXIT
# Only orchestration is under test here; child scripts are explicit test doubles.
fixture="$workspace_test_dir/repo with spaces"
mkdir -p "$fixture"/{setup-tools,setup-shell,setup-git,setup-docker,doctor} "$workspace_test_dir/home"
export HOME=$workspace_test_dir/home CALLS=$workspace_test_dir/calls
cp "$root/setup.sh" "$root/setup-bash-workstation" "$fixture/"
cp "$root/doctor/check.sh" "$fixture/doctor/"
for domain in setup-tools setup-shell setup-git setup-docker; do
    for step in install verify; do
        cat > "$fixture/$domain/$step.sh" <<'DOUBLE'
#!/usr/bin/env bash
id="$(basename "$(dirname "$0")")/$(basename "$0")"
printf '%s %s\n' "$id" "$*" >> "$CALLS"
[[ ${FAIL_STEP-} != "$id" ]] || exit 7
exit 0
DOUBLE
    done
done
cd /tmp
"$fixture/setup.sh" > "$workspace_test_dir/log"
expected=$'setup-tools/install.sh \nsetup-shell/install.sh \nsetup-git/install.sh \nsetup-docker/install.sh \nsetup-tools/verify.sh \nsetup-shell/verify.sh \nsetup-git/verify.sh \nsetup-docker/verify.sh '
[[ $(cat "$CALLS") == "$expected" ]]
grep -q 'Full workstation readiness is not assessed' "$workspace_test_dir/log"
grep -Fxq 'PLANNED (not checked): setup-workspace' "$workspace_test_dir/log"
grep -Fxq 'SKIP (not configured): Git personalization; no managed local configuration found' "$workspace_test_dir/log"
grep -Fxq 'Optional next step: Git personalization (choose new / bitwarden).' "$workspace_test_dir/log"
printf -v personal_hint '  bash %q' "$fixture/setup-git/install-personal.sh"
[[ $(tail -1 "$workspace_test_dir/log") == "$personal_hint" ]]
: > "$CALLS"
"$fixture/setup-bash-workstation" > /dev/null
legacy_expected=$'setup-tools/install.sh \nsetup-shell/install.sh --shell bash\nsetup-git/install.sh \nsetup-docker/install.sh \nsetup-tools/verify.sh \nsetup-shell/verify.sh --shell bash\nsetup-git/verify.sh \nsetup-docker/verify.sh '
[[ $(cat "$CALLS") == "$legacy_expected" ]]
for step in setup-tools/install.sh setup-shell/install.sh setup-git/install.sh setup-docker/install.sh; do
    : > "$CALLS"
    status=0
    FAIL_STEP=$step "$fixture/setup.sh" > "$workspace_test_dir/log" 2>&1 || status=$?
    [[ $status == 7 ]]
    grep -q "FAIL installation step: ${step%/*}" "$workspace_test_dir/log"
    ! grep -q 'verify.sh' "$CALLS"
    if [[ $step == setup-tools/install.sh ]]; then ! grep -q setup-shell "$CALLS"; fi
done
for step in setup-tools/verify.sh setup-shell/verify.sh setup-git/verify.sh setup-docker/verify.sh; do
    : > "$CALLS"
    status=0
    FAIL_STEP=$step "$fixture/doctor/check.sh" > "$workspace_test_dir/log" 2>&1 || status=$?
    [[ $status == 1 ]]
    (( $(wc -l < "$CALLS") == 4 ))
    grep -q PLANNED "$workspace_test_dir/log"
    [[ $(tail -1 "$workspace_test_dir/log") == "$personal_hint" ]]
done
# Exercise the real basic Git entry points inside otherwise mocked orchestration.
# This proves the default root command/doctor work without a vault or SSH setup.
cp "$root/setup-git/install.sh" "$root/setup-git/verify.sh" "$root/setup-git/common.bash" "$fixture/setup-git/"
cp "$root/setup-tools/file-operations.bash" "$fixture/setup-tools/"
export GIT_CONFIG_NOSYSTEM=1
unset GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_DIR GIT_WORK_TREE
mkdir -p "$workspace_test_dir/bin" "$HOME/.ssh"
cat > "$workspace_test_dir/bin/bw" <<'BLOCK'
#!/bin/sh
printf 'unexpected vault access\n' >> "$HOME/vault-calls"
exit 99
BLOCK
chmod +x "$workspace_test_dir/bin/bw"
export PATH="$workspace_test_dir/bin:$PATH"
printf 'existing SSH data\n' > "$HOME/.ssh/config"
cp "$HOME/.ssh/config" "$workspace_test_dir/ssh-before"
"$fixture/setup.sh" > "$workspace_test_dir/log"
[[ $(git config --global init.defaultBranch) == main ]]
! git config --global --get user.name
[[ ! -e $HOME/vault-calls && ! -e $HOME/Workspace && ! -e $HOME/.config/git ]]
cmp "$workspace_test_dir/ssh-before" "$HOME/.ssh/config"
grep -Fxq 'SKIP (not configured): Git personalization; no managed local configuration found' "$workspace_test_dir/log"
printf 'PASS dispatch order, cwd/spaces, fail-fast status and doctor aggregation (test doubles)\n'
